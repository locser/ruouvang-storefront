{
  "name": "@dtc/storefront-cwwines",
  "version": "1.0.0",
  "private": true,
  "description": "C.W. Wines — storefront rượu vang song ngữ Việt–Anh, giá VND, chặn tuổi 18+",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/chay-next.cjs dev",
